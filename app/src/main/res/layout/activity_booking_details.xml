<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAF9"
    tools:ignore="HardcodedText"
    tools:context=".BookingDetailsActivity">

    <!-- Top Navigation Header -->
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#000000" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Booking Details"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Scrollable Content Area -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomButtonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">

            <!-- Status Badge Center -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_status_badge"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:text="Status: Confirmed"
                android:textColor="#15803D"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Details Card Layout -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#F3F4F6"
                app:strokeWidth="1.5dp">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:stretchColumns="1">

                    <!-- Booking ID -->
                    <TableRow android:layout_marginBottom="16dp">
                        <TextView
                            android:text="Booking ID"
                            android:textColor="#6B7280"
                            android:textSize="14sp" />
                        <TextView
                            android:text="#BK00125"
                            android:gravity="end"
                            android:textColor="#111827"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </TableRow>

                    <!-- Service -->
                    <TableRow android:layout_marginBottom="16dp">
                        <TextView
                            android:text="Service"
                            android:textColor="#6B7280"
                            android:textSize="14sp" />
                        <TextView
                            android:text="Plumbing Service"
                            android:gravity="end"
                            android:textColor="#111827"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </TableRow>

                    <!-- Date -->
                    <TableRow android:layout_marginBottom="16dp">
                        <TextView
                            android:text="Date"
                            android:textColor="#6B7280"
                            android:textSize="14sp" />
                        <TextView
                            android:text="20 May 2025"
                            android:gravity="end"
                            android:textColor="#111827"
                            android:textSize="14sp" />
                    </TableRow>

                    <!-- Time -->
                    <TableRow android:layout_marginBottom="16dp">
                        <TextView
                            android:text="Time"
                            android:textColor="#6B7280"
                            android:textSize="14sp" />
                        <TextView
                            android:text="10:00 AM"
                            android:gravity="end"
                            android:textColor="#111827"
                            android:textSize="14sp" />
                    </TableRow>

                    <!-- Address -->
                    <TableRow android:layout_marginBottom="16dp">
                        <TextView
                            android:text="Address"
                            android:textColor="#6B7280"
                            android:textSize="14sp" />
                        <TextView
                            android:text="123, Main Street,\nColombo 05"
                            android:gravity="end"
                            android:textColor="#111827"
                            android:textSize="14sp" />
                    </TableRow>

                    <!-- Notes -->
                    <TableRow android:layout_marginBottom="16dp">
                        <TextView
                            android:text="Notes"
                            android:textColor="#6B7280"
                            android:textSize="14sp" />
                        <TextView
                            android:text="Tap is leaking"
                            android:gravity="end"
                            android:textColor="#111827"
                            android:textSize="14sp" />
                    </TableRow>

                    <!-- Technician -->
                    <TableRow android:layout_marginBottom="16dp">
                        <TextView
                            android:text="Technician"
                            android:textColor="#6B7280"
                            android:textSize="14sp" />
                        <TextView
                            android:text="John Smith"
                            android:gravity="end"
                            android:textColor="#111827"
                            android:textSize="14sp" />
                    </TableRow>

                    <!-- Phone -->
                    <TableRow android:layout_marginBottom="16dp">
                        <TextView
                            android:text="Phone"
                            android:textColor="#6B7280"
                            android:textSize="14sp" />
                        <TextView
                            android:text="077 123 4567"
                            android:gravity="end"
                            android:textColor="#111827"
                            android:textSize="14sp" />
                    </TableRow>

                    <!-- Price -->
                    <TableRow>
                        <TextView
                            android:text="Price"
                            android:textColor="#6B7280"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:text="$ 50.00"
                            android:gravity="end"
                            android:textColor="#1D4ED8"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </TableRow>

                </TableLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Buttons Container -->
    <LinearLayout
        android:id="@+id/bottomButtonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReschedule"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Reschedule"
            android:textAllCaps="false"
            android:textColor="#1D4ED8"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="#1D4ED8"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#DC2626"
            android:text="Cancel Booking"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>